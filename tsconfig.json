{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "checkJs": false,
    "target": "ES2024",
    "types": ["node", "jest"],
    "sourceMap": true,
    "outDir": "./dist",
    "ignoreDeprecations": "5.0",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "noEmitOnError": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "paths": {
      "src/*": [
        "./src/*"
      ] /* Tutaj wprowadzany jest alias dla ścieżek typu import */
    }
  },
  "include": ["public/**/*.js", "src/**/*.ts", "src/prismaDataManaging.ts"], // Uwzględnia pliki JavaScript w folderze public oraz pliki TypeScript w folderze src
  "exclude": ["node_modules", "dist"]
}
